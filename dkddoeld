local OPTION_FLAGS = {
    sell     = "FMP_SELL",
    trade    = "FMP_TRADE",
    bigorder = "FMP_BIGORDER",
    restock  = "FMP_RESTOCK",
    parcel   = "FMP_PARCEL",
    upgrade  = "FMP_UNLOCK",
}

function FMP.SetAuto(v)
    autoRunning = v and true or false
    applyAutoStatus(autoRunning and "Running" or "Stopped")
end

function FMP.SetOption(name, v)
    local flag = OPTION_FLAGS[name]
    if flag then genv[flag] = v and true or false end
end

function FMP.SetTrain(v)
    trainOn = v and true or false
    if not trainOn then trainSay("Stopped") end
end

function FMP.SetTrainOrder(v)
    if v == "Cheapest" or v == "Most Expensive" then trainOrder = v end
end

local unloaded = false
function FMP.Unload()
    if unloaded then return end
    unloaded = true
    autoRunning = false
    trainOn = false
    genv.FMP_STOP = true
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    if _G.FIXMYPHONE_Unload == FMP.Unload then _G.FIXMYPHONE_Unload = nil end
end
_G.FIXMYPHONE_Unload = FMP.Unload

return FMP
