local tradeState = {
    bias = 0.05,
    ledger = {},
    lastSeenDone = setmetatable({}, { __mode = "k" }),
    lastDeskPhone = setmetatable({}, { __mode = "k" }),
}
local CFG_TRADE = {
    BiasLearnRate = 0.15,
    BiasMin = -0.25,
    BiasMax = 0.25,
    DriftScanStep = 0.015,
    DriftScanHorizon = 6.0,
}

local function nextCrossingNoDrift(go, centre, ranNow)
    local sweep = go.sweep
    local period = 2 * sweep
    local phase = ranNow % period
    local tRise = centre * sweep
    local tFall = (2 - centre) * sweep
    local function aheadOffset(tCrossing)
        local delta = tCrossing - phase
        if delta < 0 then delta = delta + period end
        return delta
    end
    local offset = math.min(aheadOffset(tRise), aheadOffset(tFall))
    return ranNow + offset
end

local function nextCrossingWithDrift(go, centre, ranNow)
    local step = CFG_TRADE.DriftScanStep
    local horizon = CFG_TRADE.DriftScanHorizon
    local inStart, inEnd = nil, nil
    local t = 0
    while t <= horizon do
        local ran = ranNow + t
        local markerPos = TradeIns.marker(go, ran)
        local mid = TradeIns.middle(go, centre, ran)
        if math.abs(markerPos - mid) <= go.sweet then
            if not inStart then inStart = t end
            inEnd = t
        elseif inStart then
            break
        end
        t = t + step
    end
    if inStart then return ranNow + (inStart + inEnd) / 2 end
    return nextCrossingNoDrift(go, centre, ranNow)
end

local function predictFireAt(rarity, attemptIndex, temperIndex, centre, ranNow)
    local go = TradeIns.go(rarity, attemptIndex, temperIndex)
    local targetRan
    if go.drift and go.drift > 0 then
        targetRan = nextCrossingWithDrift(go, centre, ranNow)
    else
        targetRan = nextCrossingNoDrift(go, centre, ranNow)
    end
    return targetRan - tradeState.bias, targetRan, go
end

local function recordTradeOutcome(zone)
    local last = tradeState.ledger[#tradeState.ledger]
    if not last or last.zone ~= nil then return end
    last.zone = zone
    local nudge
    if zone == 1 then
        nudge = -tradeState.bias * 0.1
    else
        nudge = CFG_TRADE.BiasLearnRate * 0.05
    end
    tradeState.bias = math.clamp(tradeState.bias + nudge, CFG_TRADE.BiasMin, CFG_TRADE.BiasMax)
end

local function readOffer(shop)
    local phone = shop:GetAttribute("Trade")
    local ask = shop:GetAttribute("TradeAsk")
    if type(phone) ~= "string" or type(ask) ~= "number" then return nil end
    return {
        phone = phone,
        ask = ask,
        first = shop:GetAttribute("TradeFirst") or ask,
        line = shop:GetAttribute("TradeLine") or 1,
        goes = shop:GetAttribute("TradeGoes") or 0,
        done = shop:GetAttribute("TradeDone") or 0,
        centre = shop:GetAttribute("TradeCentre") or 0.5,
        haggleAt = shop:GetAttribute("TradeHaggleAt"),
        zone = shop:GetAttribute("TradeZone") or 0,
    }
end

local function handleTradeAttempt(shop, offer, rarity)
    NetworkClient.TradeHaggleStart.Fire()

    local haggleAt, waited = nil, 0
    while waited < 2 do
        haggleAt = shop:GetAttribute("TradeHaggleAt")
        if haggleAt then break end
        task.wait(0.05)
        waited = waited + 0.05
    end
    if not haggleAt then return end

    local temperIndex = TradeIns.temper(offer.line)
    local ranNow = workspace:GetServerTimeNow() - haggleAt
    local fireAt, targetRanNoBias = predictFireAt(rarity, offer.done, temperIndex, offer.centre, ranNow)

    table.insert(tradeState.ledger, { targetRan = targetRanNoBias, firedRan = fireAt, zone = nil })

    local nowRan = workspace:GetServerTimeNow() - haggleAt
    task.wait(math.max(0, fireAt - nowRan))

    NetworkClient.TradeHaggleStop.Fire()
    task.wait(0.4)
    recordTradeOutcome(shop:GetAttribute("TradeZone") or 0)
end

local function maybeBuy(shop, offer)
    local cash = ServerState.cash()
    if type(offer.ask) == "number" and offer.ask <= cash then
        NetworkClient.TradeBuy.Fire()
    end
end

local function tradeDesk(shop)
    local st = shop:FindFirstChild("Stations")
    return st and st:FindFirstChild("TradeDesk")
end

local function tryTrade(shop)
    if genv.FMP_TRADE == false then return false end
    if not (TradeIns and NetworkClient and ServerState) then return false end
    local offer = readOffer(shop)
    if not offer then return false end
    if tradeState.lastSeenDone[shop] == offer.done then return false end
    tradeState.lastSeenDone[shop] = offer.done

    if tradeState.lastDeskPhone[shop] ~= offer.phone then
        tradeState.lastDeskPhone[shop] = offer.phone
        local desk = tradeDesk(shop)
        if desk then goNear(desk) task.wait(0.3) end
        notify("Trading (" .. tostring(offer.phone) .. ")...")
    end
    if offer.goes > 0 then
        local phoneInfo = Phones and Phones.get(offer.phone)
        local rarity = phoneInfo and phoneInfo.rarity or 1
        handleTradeAttempt(shop, offer, rarity)
    else
        maybeBuy(shop, offer)
    end
    return true
end

local function callable(f)
    if type(f) == "function" then return true end
    if type(f) == "table" then
        local mt = getmetatable(f)
        return type(mt) == "table" and mt.__call ~= nil
    end
    return false
end

local shopFn, shopFindAt = nil, 0
local function validShopFn(f)
    if not callable(f) then return false end
    local ok, s = pcall(f)
    return ok and type(s) == "table" and type(s.parcels) == "table" and s.jobs ~= nil
end

local function findShopFn()
    if ServerState then
        local ok, f = pcall(function() return ServerState.shop end)
        if ok and validShopFn(f) then return f end
    end
    local mods = {}
    if getloadedmodules then
        for _, m in ipairs(getloadedmodules()) do mods[#mods + 1] = m end
    else
        local cf = LP:FindFirstChild("PlayerScripts") and LP.PlayerScripts:FindFirstChild("Client")
        if cf then
            for _, d in ipairs(cf:GetDescendants()) do
                if d:IsA("ModuleScript") then mods[#mods + 1] = d end
            end
        end
    end
    for _, m in ipairs(mods) do
        local ok, mod = pcall(require, m)
        if ok and type(mod) == "table" then
            local okf, f = pcall(rawget, mod, "shop")
            if okf and validShopFn(f) then return f end
        end
    end
end

local function getShop()
    if shopFn then
        local ok, s = pcall(shopFn)
        if ok and type(s) == "table" then return s end
        shopFn = nil
    end
    if os.clock() < shopFindAt then return nil end
    shopFindAt = os.clock() + 10
    local f = findShopFn()
    if f then
        shopFn = f
        local ok, s = pcall(shopFn)
        if ok and type(s) == "table" then return s end
    end
    return nil
end

local function posOf(inst)
