}

local function drag(pts, steps)
    api.point(api.spot(pts[1][1], pts[1][2]))
    RunService.RenderStepped:Wait()
    api.press()
    for i = 2, #pts do
        local a, b = pts[i - 1], pts[i]
        for s = 1, steps do
            local t = s / steps
            api.point(api.spot(a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t))
            RunService.RenderStepped:Wait()
        end
    end
    api.release()
end
local function partPos(part)
    if part:IsA("BasePart") then return part.Position end
    return part:GetPivot().Position
end
