local orderCooldown = setmetatable({}, { __mode = "k" })
local orderCache = { at = 0, list = {} }
local ORDER_COOLDOWN = 4
local ORDER_PAD = 40

local function promptPos(pr)
    local p = pr.Parent
    if p:IsA("BasePart") then return p.Position end
    if p:IsA("Attachment") then return p.WorldPosition end
    if p:IsA("Model") then return p:GetPivot().Position end
    local part = p:FindFirstAncestorWhichIsA("BasePart")
    return part and part.Position
end

local function inMyShop(shop, pos)
    local ok, cf, size = pcall(shop.GetBoundingBox, shop)
    if not ok or not cf then return true end
    local rel = cf:PointToObjectSpace(pos)
    local h = size / 2 + Vector3.new(ORDER_PAD, ORDER_PAD, ORDER_PAD)
    return math.abs(rel.X) <= h.X and math.abs(rel.Y) <= h.Y and math.abs(rel.Z) <= h.Z
end

local function takeOrder(shop)
    if blocked("order") then return false end
    if os.clock() - orderCache.at > 3 then
        orderCache.at = os.clock()
        orderCache.list = {}
        local root = workspace:FindFirstChild("CounterPhones") or shop
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Name == "Counter" then
                local pos = promptPos(d)
                local mine = pos and inMyShop(shop, pos)
                if mine then
                    orderCache.list[#orderCache.list + 1] = d
                end
            end
        end
    end

    for _, pr in ipairs(orderCache.list) do
        if pr.Parent and pr.Enabled and os.clock() - (orderCooldown[pr] or -999) > ORDER_COOLDOWN then
            local pos = promptPos(pr)
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if pos and hrp then
                orderCooldown[pr] = os.clock()
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
                task.wait(0.4)
                press(pr)
                noteAction("order", 4, 20, 15)
                return true
            end
        end
    end
    return false
end

local lastReq = {}
local function pressFixAtBench(shop)
    local spots = mySpots(shop)
    if #spots == 0 then return false end

    for _, sp in ipairs(spots) do
        if sp:GetAttribute("Tech") == nil then
            local idx = sp:GetAttribute("Index")
            local customer = sp:GetAttribute("Customer")
            local waiting = sp:GetAttribute("Waiting")

            if customer ~= nil and waiting and (lastReq[idx] or 0) < os.clock() - 6 then
                lastReq[idx] = os.clock()
                local pr = fixPrompt(sp)
                if pr then
                    goNear(sp)
                    task.wait(1.2)
                    press(pr)
                    return true
                end
            end
        end
    end
    return false
end

local holdStuckSince, lastHoldNotify = nil, -999
local HOLD_NOTIFY_AFTER = 8
local HOLD_NOTIFY_EVERY = 30

local function doFixCycle(shop)
    if not isHolding() then
        holdStuckSince = nil
        if takeOrder(shop) then return true end
        local grabbed = grabFromShelf(shop)
        local fixed = pressFixAtBench(shop)
        return grabbed or fixed
    end

    local fixed = pressFixAtBench(shop)
    if fixed then
        holdStuckSince = nil
    else
        holdStuckSince = holdStuckSince or os.clock()
        if os.clock() - holdStuckSince > HOLD_NOTIFY_AFTER and os.clock() - lastHoldNotify > HOLD_NOTIFY_EVERY then
            lastHoldNotify = os.clock()
            notify("Finish the tutorial first, then re-run the script.")
            genv.FMP_STOP = true
        end
    end
    return fixed
end

