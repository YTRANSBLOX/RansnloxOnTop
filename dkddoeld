local OWN_STEPS = { stock = true }
local OWN_TIMEOUT = 15

local FMP = {
    Version = "v1.0",
    Status = { auto = "Stopped", train = "Stopped" },
    OnStatus = nil, -- function(kind, text): kind is "auto" or "train"
}

local function emit(kind, text)
    FMP.Status[kind] = text
    local cb = FMP.OnStatus
    if cb then pcall(cb, kind, text) end
end

local autoRunning = false

local function applyAutoStatus(text)
    emit("auto", text)
end

task.spawn(function()
    local fails, lastKey, same = {}, nil, 0
    local wasWorking = false
    local ownSince = nil
    while alive() do
        if not autoRunning then
            task.wait(0.3)
        else
            pcall(closeLotsIfOpen)

            local working = isWorking() and getStep()
            local ownKey = working and stepKey() or nil

            if ownKey and OWN_STEPS[ownKey] then
                ownSince = ownSince or os.clock()
                if ownKey == "stock" and genv.FMP_RESTOCK ~= false and getgc then
                    pcall(driveStock)
                end
                if os.clock() - ownSince > OWN_TIMEOUT then
                    pcall(Bench.leave)
                    ownSince = nil
                    task.wait(1)
                end
                task.wait(0.5)
            elseif working then
                ownSince = nil
                wasWorking = true
                local ok2, res = pcall(Autoplay.run, api, 4, nil)
                if not ok2 then
                    task.wait(1.5)
                else
                    local why = tostring(res.why)
                    local k = res.step and res.step.key or "?"
                    local btn = why:match("^needs a click on a button: (%w+)")
                    if btn == "case" then
                        jitter(0.4, 0.9)
                        if not chooseCase() then
                            fails.case = (fails.case or 0) + 1
                        end
                    elseif btn then
                        jitter(0.4, 0.9)
                        pcall(Hud.pressMain)
                        if not waitStepChange(btn, 3) then
                            fails[btn] = (fails[btn] or 0) + 1
                        end
                    elseif why:find("STUCK") or why:find("no autoplay") then
                        fails[k] = (fails[k] or 0) + 1
                        task.wait(1)
                    elseif why:find("no step") then
                        task.wait(1)
                    end

                    local cur = stepKey()
                    if cur == lastKey then same = same + 1 else lastKey, same = cur, 0 end
                    if cur and SWEEP[cur] and alive() then
                        local rem = remaining(SWEEP[cur])
                        for _, it in ipairs(rem) do
                            if not alive() or stepKey() ~= cur then break end
                            sweepItem(it)
                        end
                    end
                    if cur and same >= 10 then
                        fails[cur] = (fails[cur] or 0) + 1
                        same = 0
                    end
                    for key, n in pairs(fails) do
                        if n >= 4 then
                            notify("Stopped: " .. key .. " keeps failing")
                            autoRunning = false
                            applyAutoStatus("Stopped (error)")
                        end
                    end
                end
            else
                ownSince = nil
                if wasWorking then
                    wasWorking = false
                    lastKey, same = nil, 0
                    task.wait(1.5)
                    pcall(closeBench)

                    local t0 = os.clock()
                    while os.clock() - t0 < 3 do
                        pcall(closeLotsIfOpen)
                        task.wait(0.25)
                    end
                end

                local shop = myShop()
                if shop then
                    trySell(shop)
                    local didTrade = tryTrade(shop)
                    if not didTrade then
                        local didBigOrder = tryBigOrder(shop)
                        if not didBigOrder then
                            local didRestock = false
                            if not isHolding() then
                                pcall(tryParcel)
                                local okR, resR = pcall(tryRestock)
                                didRestock = okR and resR or false
                            end
                            if not didRestock and not tryUnlock(shop) then
                                doFixCycle(shop)
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end
    end
end)

-- ===== Staff: Auto Train Technician =====
local trainOn = false
local trainOrder = "Cheapest"
local trainBlocked = {}
local trainCostSeen = {}
local trainLastStatus = ""

local function trainSay(t)
    if t == trainLastStatus then return end
    trainLastStatus = t
    emit("train", t)
end

local function techList()
    local s = getShop()
    local t = s and s.technicians
    return type(t) == "table" and t or nil
end

local function fmtMoney(n)
    if n >= 1e6 then return ("%.1fM"):format(n / 1e6) end
    if n >= 1e3 then return ("%.1fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

-- snapshot of everything that can make a skipped technician trainable again
local function trainSig()
    local s = getShop()
    if not s then return "" end
    local parts = { tostring(s.level) }
    for i, t in ipairs(s.technicians or {}) do
        parts[#parts + 1] = i .. ":" .. tostring(t.level) .. ":" .. tostring(t.watched)
    end
    return table.concat(parts, "|")
end

task.spawn(function()
    local blockedSig
    while alive() do
        RunService.Heartbeat:Wait()
        if trainOn then
            local techs = techList()
            local net = NetworkClient and NetworkClient.TrainStaff
            if not (techs and net and net.Fire) then
                trainSay("Waiting for shop data")
            else
                if blockedSig and trainSig() ~= blockedSig then
                    trainBlocked, blockedSig = {}, nil
                end

                local c = {}
                for i, t in ipairs(techs) do
                    if type(t) == "table" and type(t.level) == "number" and not trainBlocked[i] then
                        c[#c + 1] = { i = i, lv = t.level }
                    end
                end
                table.sort(c, function(a, b)
                    if trainOrder == "Most Expensive" then return a.lv > b.lv end
                    return a.lv < b.lv
                end)

                local pick = c[1]
                if not pick then
                    trainSay("Nothing trainable (max level, not watched yet, or shop level cap)")
                else
                    local cash = cashNow()
                    local known = trainCostSeen[pick.lv]
                    if known and cash < known then
                        trainSay(("Waiting for cash (need ~$%s)"):format(fmtMoney(known)))
                    else
                        pcall(net.Fire, pick.i)

                        -- wait for the server to confirm the level change, no fixed delay
                        local t0, lvAfter = os.clock(), nil
                        repeat
                            RunService.Heartbeat:Wait()
                            local after = techList()
                            lvAfter = after and after[pick.i] and after[pick.i].level
                        until (type(lvAfter) == "number" and lvAfter > pick.lv) or os.clock() - t0 > 2 or not alive()

                        if type(lvAfter) == "number" and lvAfter > pick.lv then
                            local spent = cash - cashNow()
                            if spent > 0 then
                                trainCostSeen[pick.lv] = math.max(trainCostSeen[pick.lv] or 0, spent)
                            end
                            trainSay(("Technician %d: Lv %d -> %d (cost ~$%s)")
                                :format(pick.i, pick.lv, lvAfter, fmtMoney(trainCostSeen[pick.lv] or 0)))
                        else
                            trainBlocked[pick.i] = true
                            blockedSig = trainSig()
                            trainSay(("Technician %d skipped (not ready or shop level cap)"):format(pick.i))
                        end
                    end
                end
            end
        end
    end
end)


