local function jitter(a, b) if HUMAN then task.wait(a + math.random() * (b - a)) end end
local api = {
    state = function()
        local w = getWork()
        return { working = isWorking(), step = getStep(), log = {}, shards = w and #w.shards or 0 }
    end,
    spot = function(x, z)
        local p = workspace.CurrentCamera:WorldToViewportPoint(World.frame() * Vector3.new(x, Parts.Back, z))
        return Vector2.new(p.X, p.Y)
    end,
    world = function(v)
        local p = workspace.CurrentCamera:WorldToViewportPoint(v)
        return Vector2.new(p.X, p.Y)
    end,
    point = function(v) Pointer.at = v Pointer.touch = false end,
    press = function() jitter(0.03, 0.12) Pointer.pressed = true World.pressBegan() end,
    release = function() jitter(0.02, 0.08) Pointer.pressed = false World.pressEnded() end,
