local function sweepItem(it)
    pcall(function()
        local loc = World.frame():PointToObjectSpace(partPos(it.part))
        local x = math.clamp(loc.X, -2.5, 2.5)
        local z = math.clamp(loc.Z, -5.6, 5.6)
        for _ = 1, 3 do
            local pts = {}
            for i = 0, 5 do
                pts[#pts + 1] = {
                    math.clamp(x + (i % 2 == 0 and -0.6 or 0.6), -2.5, 2.5),
                    math.clamp(z + (i % 4 < 2 and -0.25 or 0.25), -5.6, 5.6),
                }
            end
            drag(pts, 5)
            if not alive() then return end
        end
    end)
end

local function waitStepChange(k, t)
    local t0 = os.clock()
    while os.clock() - t0 < t do
        if stepKey() ~= k then return true end
        task.wait(0.1)
    end
    return false
end
local function chooseCase()
    local v = Hud.view()
    local ch = (v and v.choices) or {}
    local work = getWork()
    local want = work and work.wanted
    local idx = 1
    if want and want ~= "" then
        for i, c in ipairs(ch) do
            if type(c) == "table" then
                for _, f in ipairs({ "key", "kind", "name", "id" }) do
                    if c[f] ~= nil and tostring(c[f]):lower() == tostring(want):lower() then idx = i end
                end
            end
        end
    end
    local c = ch[idx]
    local tries = {
        function() Hud.pick(idx) end,
        function() Hud.pick(c) end,
        function() if type(c) == "table" then Hud.pick(c.key) end end,
        function() Hud.pickPicked() end,
    }
    for _, f in ipairs(tries) do
        pcall(f)
        task.wait(0.5)
        if waitStepChange("case", 0.8) then return true end
        pcall(Hud.pressMain)
        if waitStepChange("case", 1.0) then return true end
    end
    return false
end

