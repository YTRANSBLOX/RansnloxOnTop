local holdCache = { at = -999, v = false }
local function guiVisible(d, root)
    local g = d
    while g and g ~= root do
        if g:IsA("GuiObject") and not g.Visible then return false end
        if g:IsA("ScreenGui") and not g.Enabled then return false end
        g = g.Parent
    end
    return true
end
local function isHolding()
    if os.clock() - holdCache.at < 0.3 then return holdCache.v end
    holdCache.at = os.clock()
    local held = false

    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text:upper() == "PUT DOWN"
                and guiVisible(d, pg) and d.AbsoluteSize.X > 0 then
                held = true
                break
            end
        end
    end

    if not held then
        for _, o in ipairs({ LP, LP.Character }) do
            for k, v in pairs(o:GetAttributes()) do
                local lk = tostring(k):lower()
                if (lk:find("hold") or lk:find("carry") or lk:find("held")) and v and v ~= 0 and v ~= "" then
                    held = true
                end
            end
        end
    end

    holdCache.v = held
    return held
end

local loopGuard = {}
local function blocked(name)
    local g = loopGuard[name]
    return g ~= nil and os.clock() < g.block
end
local function noteAction(name, limit, window, backoff)
    local g = loopGuard[name]
    if not g then
        g = { times = {}, block = 0 }
        loopGuard[name] = g
    end
    local now = os.clock()
    g.times[#g.times + 1] = now
    while #g.times > 0 and now - g.times[1] > window do table.remove(g.times, 1) end
    if #g.times >= limit then
        g.block = now + backoff
        g.times = {}
    end
end

local grabCooldown = setmetatable({}, { __mode = "k" })
local GRAB_COOLDOWN = 3
local function grabFromShelf(shop)
    local shelf = shop:FindFirstChild("Stations") and shop.Stations:FindFirstChild("ToFixShelf")
    if not shelf then return false end
    if blocked("grab") then return false end

    for _, phone in ipairs(shelf:GetChildren()) do
        if phone.Name == "ToFixPhone" then
            local last = grabCooldown[phone]
            if not last or os.clock() - last > GRAB_COOLDOWN then
                local box = phone:FindFirstChild("Box")
                local grab = box and box:FindFirstChild("Grab")
                if box and grab and grab.Enabled then
                    grabCooldown[phone] = os.clock()
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(box.Position + Vector3.new(0, 3, 2))
                        task.wait(0.2)
                        fireproximityprompt(grab)
                        noteAction("grab", 4, 20, 15)
                        return true
                    end
                end
            end
        end
    end
    return false
end

