    end
end

local PARCEL_INTERVAL = 3
local PARCEL_PAUSE = 120
local nextParcelAt, parcelPausedUntil, parcelFails = 0, 0, 0

local function parcelCount()
    local s = getShop()
    if s and type(s.parcels) == "table" then return #s.parcels end
    return nil
end

local function tryParcel()
    if genv.FMP_PARCEL == false then return false end
    if not (NetworkClient and NetworkClient.OpenParcel and NetworkClient.OpenAllParcels) then return false end
    if os.clock() < nextParcelAt or os.clock() < parcelPausedUntil then return false end
    nextParcelAt = os.clock() + PARCEL_INTERVAL

    local n = parcelCount()
    if not n or n == 0 then return false end

    if n > 1 then
        pcall(NetworkClient.OpenAllParcels.Fire)
    else
        pcall(NetworkClient.OpenParcel.Fire, 1)
    end

    local t0, after = os.clock(), n
    while os.clock() - t0 < 5 do
        task.wait(0.25)
        after = parcelCount() or n
        if after < n then break end
    end

    if after < n then
        parcelFails = 0
        return true
    end
    parcelFails = parcelFails + 1
    if parcelFails >= 2 then
        parcelFails = 0
        parcelPausedUntil = os.clock() + PARCEL_PAUSE
    end
    return false
end

local function findStockLayouts()
    local res = {}
    for _, t in ipairs(getgc(true)) do
        if type(t) == "table" then
            pcall(function()
                local things = rawget(t, "things")
                local cells = rawget(t, "cells")
                local taken = rawget(t, "taken")
                if type(things) == "table" and type(cells) == "table" and type(taken) == "table" and #things > 0 then
                    local first = things[1]
                    local lead = type(first) == "table" and first.lead
                    if type(lead) == "table" and type(lead.drag) == "function" then
                        res[#res + 1] = t
                    end
                end
            end)
        end
    end
    return res
end

local function solveStockLayout(layout)
    for i, th in ipairs(layout.things) do
        local lead = th.lead
        if type(lead) == "table" and type(lead.drag) == "function" and type(lead.released) == "function" then
            local idx
            for c = 1, #layout.cells do
                if not layout.taken[c] then
                    idx = c
                    break
                end
            end
            if not idx then break end
            local cell = layout.cells[idx]
            lead.drag(Vector3.new(cell.X, 0, cell.Z))
            task.wait(0.08)
            lead.released()
            task.wait(0.35)
        end
    end
end

local function driveStock()
    local did = false
    for _ = 1, 8 do
        for _, l in ipairs(findStockLayouts()) do
            local ok = pcall(solveStockLayout, l)
            if ok then did = true end
        end
        if did then break end
        task.wait(0.3)
    end
    return did
end

local function restockDue()
    local s = getShop()
    if not s then return nil end
    if ShopSave and type(ShopSave.shelfDue) == "function" then
        local ok, r = pcall(ShopSave.shelfDue, s, os.time())
        if ok then return r and true or false end
    end
    return nil
end

local restockNextAt = 0
local function tryRestock()
    if genv.FMP_RESTOCK == false or not getgc then return false end
    if os.clock() < restockNextAt or blocked("restock") then return false end
    if isWorking() then return false end

    local due = restockDue()
    if due == false then return false end
    restockNextAt = os.clock() + (due and 4 or 20)

    pcall(Bench.stock)

    local opened, t0 = false, os.clock()
    while os.clock() - t0 < 2.5 do
        if stepKey() == "stock" or isWorking() then
            opened = true
            break
        end
        task.wait(0.1)
    end
    if not opened then return false end

    noteAction("restock", 4, 90, 60)
    driveStock()

    local t1 = os.clock()
    while os.clock() - t1 < 10 do
        if stepKey() ~= "stock" and not isWorking() then break end
        task.wait(0.2)
    end
    if stepKey() == "stock" or isWorking() then
        pcall(Bench.leave)
        task.wait(0.6)
        restockNextAt = os.clock() + 30
    end
    return true
end

local UNLOCK_INTERVAL = 3
local UNLOCK_RETRY = 30
local UNLOCK_SKIP = { "Theme" }
local nextUnlockAt = 0
local unlockTried = {}
local priceOf = {}

do
    local function collect(t, depth, seen)
        if type(t) ~= "table" or depth > 4 or seen[t] then return end
        seen[t] = true
        local k, c = rawget(t, "key"), rawget(t, "cost")
        if type(k) == "string" and type(c) == "number" and not priceOf[k] then priceOf[k] = c end
        for _, v in pairs(t) do
            if type(v) == "table" then collect(v, depth + 1, seen) end
        end
    end
    pcall(function() collect(require(ReplicatedStorage.Shared.Economy), 0, {}) end)
end

local function cashNow()
    if ServerState then
        local ok, c = pcall(ServerState.cash)
        if ok and type(c) == "number" then return c end
    end
    local ls = LP:FindFirstChild("leaderstats")
    local v = ls and ls:FindFirstChild("Cash")
    return v and v.Value or 0
end

local function parsePrice(txt)
    local num, suf = txt:match("^%$([%d%.]+)([KkMm]?)$")
    if not num then return nil end
    local v = tonumber(num)
    suf = suf:lower()
    if suf == "k" then v = v * 1e3 elseif suf == "m" then v = v * 1e6 end
    return v
end

local function unlockSkipped(key)
    for _, w in ipairs(UNLOCK_SKIP) do
        if key:sub(1, #w) == w then return true end
    end
    return false
end

local function unlockCandidates(shop)
    local list = {}
    local pads = shop:FindFirstChild("Pads")
    local signs = workspace:FindFirstChild("PadSigns")
    if not pads or not signs then return list end
    local cash = cashNow()

    for _, sign in ipairs(signs:GetChildren()) do
        if sign:IsA("BasePart") then
            local pad, bd
            for _, p in ipairs(pads:GetChildren()) do
                local d = (p.Position - sign.Position).Magnitude
                if not bd or d < bd then pad, bd = p, d end
            end
            local key = pad and bd < 4 and pad:GetAttribute("Key")
            if key and not unlockSkipped(key) then
                local isLevel, price = false, nil
                for _, t in ipairs(sign:GetDescendants()) do
                    if t:IsA("TextLabel") then
                        if t.Text:upper():find("^LEVEL") then isLevel = true end
                        price = price or parsePrice(t.Text)
                    end
                end
                local cost = priceOf[key] or price
                local ready = (not isLevel) and cost and cash >= cost
                if ready and os.clock() - (unlockTried[key] or -999) > UNLOCK_RETRY then
                    list[#list + 1] = { key = key, pad = pad, sign = sign, cost = cost }
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.cost < b.cost end)
    return list
end

local function tryUnlock(shop)
    if genv.FMP_UNLOCK == false then return false end
    if os.clock() < nextUnlockAt then return false end
    nextUnlockAt = os.clock() + UNLOCK_INTERVAL

    local offer = readOffer(shop)
    if offer and offer.goes > 0 then return false end

    local c = unlockCandidates(shop)[1]
    if not c then return false end

    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local back = hrp.CFrame
    unlockTried[c.key] = os.clock()
    local before = cashNow()

    if firetouchinterest then
        pcall(function()
            firetouchinterest(hrp, c.pad, 0)
            task.wait()
            firetouchinterest(hrp, c.pad, 1)
        end)
    end
    hrp.CFrame = c.pad.CFrame + Vector3.new(0, 3, 0)
    task.wait(1.3)

    local bought = (not c.sign.Parent) or cashNow() <= before - c.cost * 0.8
    if hrp.Parent then hrp.CFrame = back end

    if bought then
        notify("Unlocked " .. c.key)
    end
    return true
end

