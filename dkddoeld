local function dropPrompt(shop)
    for _, name in ipairs({ "OrderBay", "OrderKerb" }) do
        local part = shop:FindFirstChild(name, true)
        local p = part and part:FindFirstChild("CrateDrop")
        if p and p:IsA("ProximityPrompt") and p.Enabled then return p end
    end
    return nil
end

local function pickOffer(now)
    local bestKey, bestScore
    pcall(function()
        for k, o in ipairs(Contracts.offers(now, LP.UserId)) do
            if genv.FMP_ORDER_PICK == "first" then
                bestKey = k
                break
            end
            local sz = Contracts.Sizes[o.size]
            local score = sz and (sz.phones * sz.bonus) or 0
            if not bestScore or score > bestScore then
                bestKey, bestScore = k, score
            end
        end
    end)
    return bestKey or 1
end

local lastBigOrderTake = 0
local function tryBigOrder(shop)
    if genv.FMP_BIGORDER == false then return false end
    if not Contracts then return false end
    if blocked("bigorder") then return false end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not shop then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local carry = char:GetAttribute("Carrying")

    if carry == "crate" then
        local drop = dropPrompt(shop)
        if drop and hrp then
            local pos = posOf(drop.Parent)
            if pos then
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 2))
                task.wait(0.3)
                press(drop)
                noteAction("bigorder", 3, 20, 20)
                task.wait(0.6)
                return true
            end
        end
        return false
    end

    if carry ~= nil then return false end

    local pick = carryPrompt(shop)
    if pick and hrp then
        local pos = posOf(pick.Parent)
        if pos then
            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 2))
            task.wait(0.3)
            press(pick)
            noteAction("bigorder", 3, 20, 20)
            task.wait(0.6)
            return true
        end
    end

    local save = getShop()
    if save and save.contract then return false end

    local now = workspace:GetServerTimeNow()
    if save and (tonumber(save.contractNext) or 0) > now then return false end

    local cooldown = save and 6 or 15
    if os.clock() - lastBigOrderTake < cooldown then return false end
    lastBigOrderTake = os.clock()

    local key = pickOffer(now)
    pcall(function() NetworkClient.TakeContract.Fire(key) end)
    noteAction("bigorder", 3, 20, 20)
    task.wait(0.8)
    return true
end

do
