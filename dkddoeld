    for _, it in pairs(World.items) do
        if type(it) == "table" and it.part and table.find(names, it.name) then
            local p = it.part
            if p.Parent and p:IsDescendantOf(workspace) and (not p:IsA("BasePart") or p.Transparency < 0.95) then
                out[#out + 1] = it
            end
